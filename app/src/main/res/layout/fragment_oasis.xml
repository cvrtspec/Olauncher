<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/oasisLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.oasis.OasisFragment">

    <ScrollView
        android:id="@+id/oasisScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/oasisContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/oasisTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="@string/oasis_title"
                android:textSize="22sp"
                android:textStyle="bold" />

            <include
                android:id="@+id/todoBlock"
                layout="@layout/oasis_todo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/notesBlock"
                layout="@layout/oasis_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/calendarBlock"
                layout="@layout/oasis_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/pomoBlock"
                layout="@layout/oasis_pomodoro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/oasisSettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/oasis_card"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/oasis_settings"
                android:textSize="15sp" />

            <Space
                android:id="@+id/oasisBottomSpacer"
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
