<?xml version="1.0" encoding="utf-8"?>
<app.olauncher.ui.oasis.SwipeBackLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/oasisLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.oasis.OasisFragment">

    <ScrollView
        android:id="@+id/oasisScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/oasisContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="32dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp">

            <include
                android:id="@+id/todoBlock"
                layout="@layout/oasis_todo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/notesBlock"
                layout="@layout/oasis_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/calendarBlock"
                layout="@layout/oasis_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/pomoBlock"
                layout="@layout/oasis_pomodoro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space
                android:id="@+id/oasisBottomSpacer"
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>
</app.olauncher.ui.oasis.SwipeBackLayout>
