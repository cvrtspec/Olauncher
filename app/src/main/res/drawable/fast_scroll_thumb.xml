<?xml version="1.0" encoding="utf-8"?>
<!-- Old-school quick-scroll grip: grey rounded tab with three lines; the RecyclerView fast scroller
     stretches the tab to the list proportion and keeps the lines centred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B3808080" />
            <corners android:radius="4dp" />
            <size
                android:width="34dp"
                android:height="52dp" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="14dp"
        android:drawable="@drawable/ic_grip_lines"
        android:gravity="center" />
</layer-list>
